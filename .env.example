# ---------------------------------------------------------------------------
# Senal Group — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Neon Postgres. Use the POOLED connection string (it has "-pooler" in the host).
DATABASE_URI=

# Any long random string. Generate one with:  openssl rand -base64 32
# Changing this invalidates every existing admin login session.
PAYLOAD_SECRET=

# The site's public origin — drives canonical URLs, the sitemap, JSON-LD and
# Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://senalgroup.com

# The two sibling companies. Used by the footer, the Our Services cards and the
# subOrganization entries in the Organization JSON-LD.
NEXT_PUBLIC_SENAL_SKY_URL=https://senalsky.com
NEXT_PUBLIC_SENAL_SITE_URL=https://senalsite.com

# Vercel Blob. Leave BLANK locally — Payload falls back to disk storage and
# `next dev` works with no cloud credentials. Set it on Vercel only.
BLOB_READ_WRITE_TOKEN=
# The hostname part of your Blob store URL, e.g. abc123.public.blob.vercel-storage.com
# Only needed if it does not match *.public.blob.vercel-storage.com.
NEXT_PUBLIC_BLOB_HOSTNAME=
